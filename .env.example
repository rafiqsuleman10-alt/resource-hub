# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings > API). Never commit .env.local.

# Public: safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SECRET: only used by "npm run seed". Never put this in Vercel's public
# settings, never share it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
